{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gen-bei-song-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "vars": { "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gen-bei-song",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "gen-bei-song-private" }],
  "env": {
    "production": {
      "name": "gen-bei-song-api",
      "workers_dev": true,
      // Private clips must always pass through Worker authentication, including
      // direct asset URLs and browser navigations. Never use asset-first routing.
      "assets": {
        "directory": "media/private-audio",
        "binding": "PRIVATE_AUDIO",
        "run_worker_first": true,
        "html_handling": "none",
        "not_found_handling": "none",
      },
      "vars": {
        "ALLOWED_ORIGINS": "https://wutongyu223.github.io,http://127.0.0.1:5173,http://localhost:5173",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gen-bei-song",
          "database_id": "45997c26-d60c-4b68-98d7-676c67139110",
          "migrations_dir": "worker/migrations",
        },
      ],
      "r2_buckets": [],
    },
  },
}
